    "# Casino Game\n\nA little text-based betting game I built to practice loops, conditions and handling user input.\n\nYou start with a wallet, place a bet, and pick a number between 0 and 49. If you guess the exact number your bet is tripled; if you only get the parity right (odd/even) you win half your bet; otherwise you lose it. The game keeps going until your money runs out.\n\nThe only thing I changed from my original version is a small bug fix: the random target number was generated with `randint(0,50)`, which could return 50 even though the player can only pick up to 49. I changed it to `randint(0,49)` so the range matches. Everything else is exactly as I wrote it.
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "id": "A_6axwx0wqFP",
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "outputId": "a6bd5485-c240-4320-a4af-f037ae15c56f"
   },
   "source": [
    "l1=[]\n",
    "wallet=input(\"type your ammount of money in dollars:\")\n",
    "while \"$\" not in wallet:\n",
    "  print(\"type your ammount in dollars!\")\n",
    "  wallet=input(\"\")\n",
    "else:\n",
    "  wallet=float(wallet[0:len(wallet)-1])\n",
    "while wallet>0:\n",
    "  placing=input(\"enter your placing in dollars:\")\n",
    "  while \"$\" not in placing:\n",
    "    print(\"type a placing in dollars:\")\n",
    "    placing=input(\"\")\n",
    "  else:\n",
    "    placing=float(placing[0:len(placing)-1])\n",
    "    while placing==0 or placing>wallet :\n",
    "      print(\"enter a correct placing:\")\n",
    "      placing=input(\"\")\n",
    "      while \"$\" not in placing:\n",
    "        print(\"type a placing in dollars:\")\n",
    "        placing=input(\"\")\n",
    "      else:\n",
    "       placing=float(placing[0:len(placing)-1])\n",
    "    else:\n",
    "      wallet=wallet-placing\n",
    "      for i in range(50):\n",
    "        l1.append(int(i))\n",
    "      try:\n",
    "        num=int(input(\"choose a number between 0 and 49:\"))\n",
    "      except:\n",
    "        try:\n",
    "          num=int(input(\"type a correct number between 0 and 49:\"))\n",
    "        except:\n",
    "          try:\n",
    "            num=int(input(\"type a correct number between 0 and 49:\"))\n",
    "          except:\n",
    "            print(\"you typed an invalid number too many times,you've been excluded from the game!\")\n",
    "            break\n",
    "      while num not in l1:\n",
    "        try:\n",
    "          num=int(input(\"choose a correct number between 0 and 49:\"))\n",
    "        except:\n",
    "          try:\n",
    "            num=int(input(\"type a correct number between 0 and 49:\"))\n",
    "          except:\n",
    "            print(\"you typed an invalid number too many times,you've been excluded from the game!\")\n",
    "            wallet=0\n",
    "            break\n",
    "      else:\n",
    "        from random import randint\n",
    "        y=randint(0,49)\n",
    "        if num==y:\n",
    "          wallet=wallet+placing*3\n",
    "          print(\"you won!you have now:\",wallet,\"$\")\n",
    "        elif y%2==0:\n",
    "          if num%2==0:\n",
    "            wallet=wallet+placing+placing/2\n",
    "            print(\"the correct number was:\",y)\n",
    "            print(\"you won half of your placing,you have now:\",wallet,\"$\")\n",
    "          else:\n",
    "            print(\"the correct number was:\",y)\n",
    "            print(\"you lost:( you have now:\",wallet,\"$\")\n",
    "        elif y%2!=0:\n",
    "          if num%2!=0:\n",
    "            wallet=wallet+placing+placing/2\n",
    "            print(\"the correct number was:\",y)\n",
    "            print(\"you won half of your placing,you have now:\",wallet,\"$\")\n",
    "          else:\n",
    "            print(\"the correct number was:\",y)\n",
    "            print(\"you lost:( you have now:\",wallet,\"$\")\n",
    "\n",
    "else:\n",
    "  print(\"game over!\")"
   ],
